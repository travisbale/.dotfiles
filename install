#!/usr/bin/env bash

set -e

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NEOVIM_VERSION="0.12.1"

# Each line: source (relative to dotfiles) -> target (absolute)
LINKS=(
    ".gitconfig                         ~/.gitconfig"
    "zsh/.zshrc                         ~/.zshrc"
    "zsh/.zshenv                        ~/.zshenv"
    "zsh/.zprofile                      ~/.zprofile"
    "tmux/.tmux.conf                    ~/.tmux.conf"
    "tmux/onedark.tmux                  ~/.tmux/themes/onedark.tmux"
    "alacritty/alacritty.toml           ~/.config/alacritty/alacritty.toml"
    "alacritty/onedark.toml             ~/.config/alacritty/onedark.toml"
    "alacritty/gruvbox.toml             ~/.config/alacritty/gruvbox.toml"
    "nvim/init.lua                      ~/.config/nvim/init.lua"
    "nvim/ftplugin                      ~/.config/nvim/ftplugin"
    "nvim/config                        ~/.config/nvim/lua/config"
    "nvim/plugins                       ~/.config/nvim/lua/plugins"
)

# Ask what to do about a real (non-symlink) file or dir sitting where we want
# to create a symlink. Sets CONFLICT_RESULT to one of: backup | replace | skip.
# Remembers an "all" choice in CONFLICT_ACTION so the user is only asked once if
# they like. Uses a global rather than echoing so the remembered choice survives
# (a $(...) subshell assignment would be lost).
resolve_conflict() {
    local dst="$1"

    case "$CONFLICT_ACTION" in
        backup-all)  CONFLICT_RESULT=backup;  return ;;
        replace-all) CONFLICT_RESULT=replace; return ;;
        skip-all)    CONFLICT_RESULT=skip;    return ;;
    esac

    # Non-interactive run: never destroy data silently, just skip.
    if [ ! -t 0 ]; then
        CONFLICT_RESULT=skip
        return
    fi

    local choice
    while true; do
        printf '  %s exists and is not a symlink. [b]ackup / [r]eplace / [s]kip (append "a" for all: ba/ra/sa): ' "$dst" >&2
        read -r choice
        case "$choice" in
            b|backup)       CONFLICT_RESULT=backup;  return ;;
            r|replace)      CONFLICT_RESULT=replace; return ;;
            s|skip|"")      CONFLICT_RESULT=skip;    return ;;
            ba|backup-all)  CONFLICT_ACTION=backup-all;  CONFLICT_RESULT=backup;  return ;;
            ra|replace-all) CONFLICT_ACTION=replace-all; CONFLICT_RESULT=replace; return ;;
            sa|skip-all)    CONFLICT_ACTION=skip-all;    CONFLICT_RESULT=skip;    return ;;
            *) echo "  Please answer b, r, or s (append 'a' to apply to all remaining)." >&2 ;;
        esac
    done
}

link() {
    local src="$DOTFILES/$1"
    local dst="${2/#\~/$HOME}"
    local parent
    parent="$(dirname "$dst")"

    if [ ! -e "$src" ]; then
        echo "SKIP  $1 (source missing)"
        return
    fi

    mkdir -p "$parent"

    # Leave correct links untouched. Recreating them makes programs that watch
    # their config (e.g. alacritty's live_config_reload) reload mid-install,
    # while imported files like the theme are briefly missing.
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
        echo "OK    $dst"
        return
    fi

    # Remove an existing symlink outright; for a real file/dir, ask the user
    # whether to back it up, replace it, or skip.
    if [ -L "$dst" ]; then
        rm "$dst"
    elif [ -e "$dst" ]; then
        resolve_conflict "$dst"
        case "$CONFLICT_RESULT" in
            backup)
                local backup="$dst.backup-$(date +%Y%m%d%H%M%S)"
                mv "$dst" "$backup"
                echo "BACKUP $dst -> $backup"
                ;;
            replace)
                rm -rf "$dst"
                echo "RM    $dst (replacing)"
                ;;
            skip)
                echo "SKIP  $dst (exists, not a symlink)"
                return
                ;;
        esac
    fi

    ln -s "$src" "$dst"
    echo "LINK  $dst -> $src"
}

clean_dead_symlinks() {
    echo ""
    echo "Cleaning dead symlinks in ~..."
    local count=0
    while IFS= read -r -d '' f; do
        echo "CLEAN $f"
        rm "$f"
        ((count++))
    done < <(find "$HOME" -maxdepth 1 -type l ! -exec test -e {} \; -print0 2>/dev/null)
    [ "$count" -eq 0 ] && echo "  (none found)"
}

install_apt_packages() {
    # Packages needed for various tools to work:
    # - zsh: the login shell these dotfiles configure
    # - python3-venv: required by Mason to install black
    # - ripgrep: required by Telescope's live_grep
    # - fd-find: faster file search for Telescope (provides `fdfind` binary)
    # - gnupg: provides gpg for signing git commits
    # - build-essential: provides gcc/cc to compile nvim-treesitter parsers
    # - tree-sitter-cli: provides `tree-sitter`, used by nvim-treesitter (main
    #   branch) to build parsers via `tree-sitter build`
    # - nodejs/npm: required by Mason to install markdownlint (and other JS tools)
    # - golang-go: provides go, required by Mason to install goimports
    # - unzip: required by Mason to extract stylua (and other zipped releases)
    # - fontconfig: provides fc-cache/fc-list to install and detect the nerd font
    local packages=(zsh python3-venv ripgrep fd-find gnupg build-essential tree-sitter-cli nodejs npm golang-go unzip fontconfig)
    local missing=()

    for pkg in "${packages[@]}"; do
        dpkg -s "$pkg" &>/dev/null || missing+=("$pkg")
    done

    if [ "${#missing[@]}" -eq 0 ]; then
        echo "apt packages already installed: ${packages[*]}"
        return
    fi

    sudo apt-get update -qq

    # Skip packages this distro doesn't carry rather than failing the whole
    # install; whatever depends on them will just be unavailable.
    local available=()
    for pkg in "${missing[@]}"; do
        if apt-cache policy "$pkg" 2>/dev/null | grep -q 'Candidate: [^(]'; then
            available+=("$pkg")
        else
            echo "WARN  apt package $pkg not available, skipping"
        fi
    done

    [ "${#available[@]}" -eq 0 ] && return

    echo "Installing apt packages: ${available[*]}"
    sudo apt-get install -y "${available[@]}"
}

install_neovim() {
    local current
    current="$(nvim --version 2>/dev/null | head -1 | grep -oP 'v\K[0-9]+\.[0-9]+\.[0-9]+')" || true

    if [ "$current" = "$NEOVIM_VERSION" ]; then
        echo "Neovim v$NEOVIM_VERSION already installed"
        return
    fi

    echo "Installing Neovim v$NEOVIM_VERSION..."
    local arch
    case "$(uname -m)" in
        x86_64)  arch="x86_64" ;;
        aarch64) arch="aarch64" ;;
        armv7l)  arch="armv7l" ;;
        *)       echo "ERROR: unsupported architecture $(uname -m)"; return 1 ;;
    esac

    local tarball="nvim-linux-${arch}.tar.gz"
    local url="https://github.com/neovim/neovim/releases/download/v${NEOVIM_VERSION}/${tarball}"
    local tmp
    tmp="$(mktemp -d)"

    curl -fsSL "$url" | tar xz -C "$tmp"
    sudo rm -rf /opt/nvim
    sudo mv "$tmp/nvim-linux-${arch}" /opt/nvim
    sudo ln -sf /opt/nvim/bin/nvim /usr/local/bin/nvim
    rm -rf "$tmp"

    echo "Neovim v$NEOVIM_VERSION installed to /opt/nvim"
}

install_nerd_font() {
    # Alacritty (alacritty/alacritty.toml) is configured to use
    # "DroidSansMono Nerd Font"; install it so glyphs/icons render.
    local font="DroidSansMono"
    local font_dir="$HOME/.local/share/fonts"

    if command -v fc-list &>/dev/null && \
       fc-list 2>/dev/null | grep -qi "droidsansm.*nerd font"; then
        echo "DroidSansMono Nerd Font already installed"
        return
    fi

    echo "Installing DroidSansMono Nerd Font..."
    local url="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/${font}.zip"
    local tmp
    tmp="$(mktemp -d)"

    if ! curl -fsSL "$url" -o "$tmp/${font}.zip"; then
        echo "WARN  failed to download nerd font from $url"
        rm -rf "$tmp"
        return
    fi

    mkdir -p "$font_dir"
    unzip -oq "$tmp/${font}.zip" -d "$font_dir" -x "*.md" "LICENSE*"
    rm -rf "$tmp"

    if command -v fc-cache &>/dev/null; then
        fc-cache -f "$font_dir" >/dev/null 2>&1
    fi
    echo "DroidSansMono Nerd Font installed to $font_dir"
}

set_default_shell() {
    local zsh_path
    zsh_path="$(command -v zsh)" || { echo "zsh not found, skipping shell change"; return; }

    if [ "$SHELL" = "$zsh_path" ] && [ "$(getent passwd "$USER" | cut -d: -f7)" = "$zsh_path" ]; then
        echo "Default shell already zsh ($zsh_path)"
        return
    fi

    echo "Setting default shell to $zsh_path..."
    if chsh -s "$zsh_path"; then
        echo "Default shell changed to zsh (restart your session to take effect)"
    else
        echo "WARN  chsh failed; run manually: chsh -s $zsh_path"
    fi
}

setup_git_signing() {
    local local_config="$HOME/.gitconfig.local"

    if ! command -v gpg &>/dev/null; then
        echo "WARN  gpg not found, skipping git signing key setup"
        return
    fi

    # Skip if a signing key is already configured and still present in the keyring.
    local existing_key
    existing_key="$(git config --file "$local_config" --get user.signingkey 2>/dev/null)" || true
    if [ -n "$existing_key" ] && gpg --list-secret-keys "$existing_key" &>/dev/null; then
        echo "Git signing key already configured ($existing_key)"
        return
    fi

    # Need an interactive terminal to prompt for the email.
    if [ ! -t 0 ]; then
        echo "WARN  non-interactive run, skipping git signing key setup"
        return
    fi

    local email
    read -rp "Email for git commits (used as git user.email and signing key UID): " email
    if [ -z "$email" ]; then
        echo "WARN  no email entered, skipping git signing key setup"
        return
    fi

    local name
    name="$(git config --get user.name)" || true
    [ -z "$name" ] && name="$email"

    echo "Generating ed25519 GPG signing key for $name <$email>..."
    gpg --batch --passphrase '' --quick-generate-key "$name <$email>" ed25519 sign never

    local keyid
    keyid="$(gpg --list-secret-keys --with-colons "$email" | awk -F: '/^sec:/ {print $5; exit}')"
    if [ -z "$keyid" ]; then
        echo "WARN  could not determine generated key id, skipping git config"
        return
    fi

    git config --file "$local_config" user.email "$email"
    git config --file "$local_config" user.signingkey "$keyid"
    echo "Git signing configured: $keyid ($email) -> $local_config"
    echo "Add the public key to GitHub/GitLab with:"
    echo "  gpg --armor --export $keyid"
}

echo "Installing dotfiles..."
echo ""

for entry in "${LINKS[@]}"; do
    read -r src dst <<< "$entry"
    link "$src" "$dst"
done

clean_dead_symlinks

echo ""
install_apt_packages

echo ""
install_neovim

echo ""
install_nerd_font

echo ""
set_default_shell

echo ""
setup_git_signing

echo ""
echo "Done!"
